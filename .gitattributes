# Normalise line endings.
#
# This repository is developed on Windows and deployed to Ubuntu 18.04 on ARM64.
# Shell scripts, systemd units and desktop entries MUST arrive on the Jetson with
# LF endings: a CRLF shebang line makes the kernel report "bad interpreter", and
# systemd silently mis-parses CRLF unit files. Forcing LF here removes an entire
# class of "works on my machine" deployment failures.

* text=auto eol=lf

# ---- Always LF, regardless of platform ----------------------------------
*.sh            text eol=lf
*.bash          text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.socket        text eol=lf
*.desktop       text eol=lf
*.conf          text eol=lf
*.sql           text eol=lf
*.go            text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.json          text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Makefile        text eol=lf
Dockerfile      text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# ---- Windows-only helper scripts keep CRLF ------------------------------
*.ps1           text eol=crlf
*.cmd           text eol=crlf
*.bat           text eol=crlf

# ---- Binary: never touch --------------------------------------------------
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.otf           binary
*.eot           binary
*.pdf           binary
*.mp4           binary
*.webm          binary
*.zip           binary
*.gz            binary
*.tar           binary
*.db            binary

# ---- Diff behaviour -------------------------------------------------------
*.svg           text eol=lf diff
go.sum          text eol=lf -diff
package-lock.json text eol=lf -diff linguist-generated=true
